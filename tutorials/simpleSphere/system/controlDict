FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     dsmcFoamPlus;

nTerminalOutputs	1;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         2e-4;

deltaT          1e-6;

writeControl    runTime;

writeInterval   1e-4;

purgeWrite      2;

writeFormat     ascii;

writePrecision  10;

writeCompression off;

timeFormat      general;

timePrecision   10;

runTimeModifiable true;

adjustTimeStep  no;

functions
{
  refineFunc
  {
    libs
      (
        "libutilityFunctionObjects.so"
      );
    type coded;
    name refineFunction;
    writeControl writeTime;
    executeControl timeStep;
    codeOptions
    #{
        -I$(LIB_SRC)/finiteVolume/lnInclude \
        -I$(LIB_SRC)/OpenFOAM/lnInclude \
        -I$(LIB_SRC)/finiteVolume/lnInclude
    #};
    codeInclude
    #{
        #include "volFieldsFwd.H"
    #};
    codeData
    #{

    #};
    codeRead
    #{

    #};
    codeExecute
    #{
        static autoPtr<volScalarField> refineField_;
        // check in into database in order to be visible for the
        // refinement

        // take a fixed diameter instead of reading/averaging each time:
        const scalar& C0 = 7.837245502911358e-19; // sqrt(2)*pi*4.2e-10**2

        const scalarField& N = mesh().lookupObject<scalarField>("rhoN_Ar");
        const scalarField& nParticles = mesh().lookupObject<scalarField>("dsmcRhoN_Ar");

        if(!refineField_.valid())
        {
        Info << "Creating refineField_" << nl;



        refineField_.reset
        (
            new volScalarField
            (
                IOobject
                (
                    "refineField",
                    mesh().time().timeName(),
                    mesh(),
                    IOobject::READ_IF_PRESENT,
                    IOobject::AUTO_WRITE
                ),
            mesh(),
            dimensionedScalar("refineField", dimless, scalar(0.0)),
            zeroGradientFvPatchField<scalar>::typeName
            )
        );
        }
        




        for (label celli = 0; celli < mesh().nCells(); celli++)
        {
            refineField_()[celli] = SMALL;
            // define 400/8= 50 as prox. minimum particle number in cell
            if (nParticles[celli] > 400)
            {
               refineField_()[celli] = C0 * N[celli] * pow(mesh().V()[celli], 1./3.);
            }
            else
            {
                if (nParticles[celli] < 50)
                {
                    refineField_()[celli] = 0.1; // unrefine mesh for low number of simulation particle
                }
                else
                {
                    refineField_()[celli] = 0.7; // not unrefine + not refine
                }
            }
        }

    
    #};
    codeWrite
    #{

    #};
  }
}




