FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      createPatchDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

pointSync false;

patches
(
    {
        name statGrid_master;

        patchInfo
        {
            type cyclic;
            neighbourPatch  statGrid_slave;
        }


        constructFrom patches;

        patches (baffle_cyclic);
    }
    {
        name statGrid_slave;

        patchInfo
        {
            type cyclic;
            neighbourPatch  statGrid_master;
        }


        constructFrom patches;

        patches (baffle_cyclic_slave);
    }

);
