    maxBoundarySkewness 20;
    maxInternalSkewness 4;
    maxConcave      80;
    minVol          1e-200;
    minTetQuality   1e-09;
    minArea         -1;
    minTwist        0.05;
    minDeterminant  1.0; //0.001;
    minFaceWeight   0.05;
    minVolRatio     0.001;
    minTriangleTwist -1;
    nSmoothScale    4;
    errorReduction  0.75;
    relaxed
