FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     dsmcFoamPlus;

startFrom       latestTime;

nTerminalOutputs 1;

startTime       latestTime;

stopAt          endTime;

endTime         2e-04;

deltaT          5e-07;

writeControl    runTime;

writeInterval   2.5e-05; //5e-06;

purgeWrite      10;

writeFormat     binary;

writePrecision  15;

writeCompression off;

timeFormat      general;

timePrecision   12;

runTimeModifiable true;

adjustTimeStep  no;

DebugSwitches
{
    polyMesh        0;
    fvMesh          0;
    decompositionMethod 0;
    OFstream        0;
}

