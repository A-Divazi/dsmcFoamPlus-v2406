#!/bin/bash
cd "$(dirname -- "$0")" || exit 1
#------------------------------------------------------------------------------
# Continue from the latest written time, with the rank count of
# system/decomposeParDict (override once with NP=n ./Allcont).
#------------------------------------------------------------------------------

: "${HOME:=/home/ubuntu}"; export HOME
: "${USER:=ubuntu}"; export USER

if [ -z "${WM_PROJECT_DIR:-}" ] || [ "${WM_PROJECT_VERSION:-}" != "v2406" ]
then
    . /home/ubuntu/opt/setup-openfoam2406.sh
fi
. "${WM_PROJECT_DIR:?}/bin/tools/RunFunctions"

application=$(getApplication)

if [ -n "${NP:-}" ]
then
    foamDictionary -entry numberOfSubdomains -set "$NP" system/decomposeParDict
fi

# continue from the latest written time (without this the solver restarts at
# startTime, i.e. "Continue" would behave like a fresh Run)
foamDictionary -entry startFrom -set latestTime system/controlDict

nProcs=$(foamDictionary -entry numberOfSubdomains -value system/decomposeParDict)

rm -f log."$(basename "$application")"

runParallel -np "$nProcs" "$application"

touch "${PWD##*/}.foam"
