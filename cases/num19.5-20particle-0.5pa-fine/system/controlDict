FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    object          controlDict;
}

application     dsmcFoamPlus;

nTerminalOutputs 1;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         1.1e-06;

deltaT          5.2426e-07;

writeControl    runTime;

writeInterval   0.005;

purgeWrite      6;

writeFormat     ascii;

writePrecision  10;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

adjustTimeStep  no;

libs            ( "libUserDsmcFoam.so" );

functions
{
    massFlow1
    {
        type            dsmcMassFlowRate;
        patches         ( flow );
        sections        ( 1 2 );
        sectionsTol     0.002;
        rhoMField       rhoM_mix;
        UField          UMean_mix;
        executeControl  timeStep;
        writeControl    none;
    }
    wallShear1
    {
        type            wallShearStressDsmc;
        fDField         fD_mix;
        tauField        wallShearStress;
        tauMagField     wallShearStressMag;
        writeControl    writeTime;
    }
    gradRho1
    {
        type            dsmcGradRho;
        rhoField        rhoN_mix;
        gradField       gradRho;
        magField        gradRhoMag;
        writeControl    writeTime;
    }
}


