FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fieldPropertiesDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dsmcFields
(
    field
    {
        fieldModel                      dsmcVolFields;

        timeProperties
        {
            timeOption                  write;
            resetAtOutput               true;
        }

        dsmcVolFieldsProperties
        {
            fieldName                   mix;
            typeIds                     (Ar);

            measureMeanFreePath         false;
            mfpReferenceTemperature     150;

            measureErrors               true;

            densityOnly                 false;
        }
    }
);

