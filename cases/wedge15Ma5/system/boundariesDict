FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      boundariesDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

//- supersonic free-stream at patch flow (left, top and bottom faces),
//  Mach 5 air: N2 + O2, T = 300 K, U = (1736 0 0) m/s
dsmcGeneralBoundaries
(
    boundary
    {
        generalBoundaryProperties
        {
            patchName                           flow;
        }

        boundaryModel   dsmcFreeStreamInflowPatch;

        dsmcFreeStreamInflowPatchProperties
        {
            typeIds             (N2 O2);

            numberDensities
            {
                N2              0.777e+20;
                O2              0.223e+20;
            }

            velocity            (1736 0 0);

            translationalTemperature        300;
            rotationalTemperature           300;
            vibrationalTemperature          300;
            electronicTemperature           300;
        }
    }
);


//- outlet / outflow and the diffuse walls
dsmcPatchBoundaries
(
    boundary                                      // outflow (right face)
    {
        patchBoundaryProperties
        {
            patchName                           flow;
        }

        boundaryModel   dsmcDeletionPatch;

        dsmcDeletionPatchProperties
        {
            allSpecies      yes;
        }
    }

    boundary                                      // 15 deg wedge ramp
    {
        patchBoundaryProperties
        {
            patchName                           obstacle;
        }

        boundaryModel   dsmcDiffuseWallPatch;

        dsmcDiffuseWallPatchProperties
        {
            temperature     550;
            velocity        (0 0 0);
        }
    }
);


//- no cyclic (statistical mesh) boundaries in this case
dsmcCyclicBoundaries
(
);

